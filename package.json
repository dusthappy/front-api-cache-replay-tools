    "@vitejs/plugin-vue": "6.0.10",
    "axios": "1.20.0",
    "esbuild": "0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.1.5"
  }
